python3 << 'EOF'
import sqlite3
import hashlib
import time

DB_PATH = "zami_leads.db"

def hash_password(pwd):
    return hashlib.sha256(pwd.encode()).hexdigest()

conn = sqlite3.connect(DB_PATH)
cursor = conn.cursor()

# Drop old tables if exist (clean slate)
cursor.execute("DROP TABLE IF EXISTS agencies")
cursor.execute("DROP TABLE IF EXISTS agency_leads")
cursor.execute("DROP TABLE IF EXISTS lead_messages")
cursor.execute("DROP TABLE IF EXISTS lead_quotes")
cursor.execute("DROP TABLE IF EXISTS users")
cursor.execute("DROP TABLE IF EXISTS user_properties")
cursor.execute("DROP TABLE IF EXISTS contractors")
cursor.execute("DROP TABLE IF EXISTS contractor_leads")
cursor.execute("DROP TABLE IF EXISTS leads")

# Create agencies table
cursor.execute("""
    CREATE TABLE agencies (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        company_name TEXT NOT NULL,
        email TEXT UNIQUE NOT NULL,
        phone TEXT,
        siret TEXT,
        address TEXT,
        password_hash TEXT NOT NULL,
        subscription_type TEXT DEFAULT 'free',
        credits INTEGER DEFAULT 0,
        created_at TEXT,
        updated_at TEXT
    )
""")

# Create agency_leads table
cursor.execute("""
    CREATE TABLE agency_leads (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        agency_id INTEGER,
        property_address TEXT,
        property_dpe TEXT,
        property_surface REAL,
        estimated_budget REAL,
        customer_name TEXT,
        customer_phone TEXT,
        customer_email TEXT,
        status TEXT DEFAULT 'pending',
        assigned_at TEXT,
        accepted_at TEXT,
        rejected_at TEXT
    )
""")

# Create messages table
cursor.execute("""
    CREATE TABLE lead_messages (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        lead_id INTEGER,
        sender_type TEXT,
        sender_id INTEGER,
        message TEXT,
        sent_at TEXT
    )
""")

# Create quotes table
cursor.execute("""
    CREATE TABLE lead_quotes (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        lead_id INTEGER,
        agency_id INTEGER,
        quote_amount REAL,
        quote_details TEXT,
        status TEXT DEFAULT 'pending',
        created_at TEXT
    )
""")

# Create users table
cursor.execute("""
    CREATE TABLE users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        username TEXT UNIQUE,
        email TEXT UNIQUE,
        password_hash TEXT,
        created_at TEXT
    )
""")

# Create user_properties table
cursor.execute("""
    CREATE TABLE user_properties (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER,
        timestamp TEXT,
        address TEXT,
        zipcode TEXT,
        dpe TEXT,
        surface REAL,
        cost REAL,
        roi REAL,
        lat REAL,
        lon REAL
    )
""")

# Create contractors table
cursor.execute("""
    CREATE TABLE contractors (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        company_name TEXT NOT NULL,
        email TEXT UNIQUE NOT NULL,
        phone TEXT,
        rge_certified INTEGER DEFAULT 1,
        service_areas TEXT,
        work_types TEXT,
        subscription_type TEXT DEFAULT 'free',
        created_at TEXT,
        updated_at TEXT
    )
""")

# Create leads table (website leads)
cursor.execute("""
    CREATE TABLE leads (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        timestamp TEXT,
        property_address TEXT,
        zipcode TEXT,
        initial_dpe TEXT,
        target_dpe TEXT,
        selected_scenario TEXT,
        estimated_cost REAL,
        owner_name TEXT,
        owner_phone TEXT,
        owner_email TEXT,
        callback_time TEXT,
        notes TEXT
    )
""")

# Insert dummy agency
current_time = time.strftime("%Y-%m-%d %H:%M:%S")
cursor.execute("""
    INSERT INTO agencies (company_name, email, phone, siret, address, password_hash, created_at, updated_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
""", ("Dummy Agency", "dummy@agency.com", "0612345678", "123456789", "Paris, France", 
      hash_password("dummy123"), current_time, current_time))

conn.commit()
conn.close()

# Verify
conn = sqlite3.connect(DB_PATH)
cursor = conn.cursor()
cursor.execute("SELECT name FROM sqlite_master WHERE type='table'")
tables = cursor.fetchall()
print("✅ Tables created:", [t[0] for t in tables])

cursor.execute("SELECT id, company_name, email FROM agencies")
agencies = cursor.fetchall()
print("✅ Agencies:", agencies)
conn.close()
EOF